# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env
POSTGRES_DB=eventdb
POSTGRES_USER=eventuser
POSTGRES_PASSWORD=ganti_dengan_password_database

# Kunci penandatangan token login (isi string acak panjang, mis. hasil: openssl rand -hex 32)
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRE_HOURS=8

# Akun admin awal (dibuat otomatis saat backend pertama kali jalan)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_dengan_password_admin

FRONTEND_PORT=8080
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Unggahan poster (volume Docker). Batas ukuran dalam byte (default 5 MB).
MAX_UPLOAD_BYTES=5242880
# URL publik aplikasi, dipakai pada tautan di email (kosongkan bila lokal)
PUBLIC_BASE_URL=

# Peta dan geocoding memakai Nominatim/OpenStreetMap (gratis, tanpa API key).
# Ganti User-Agent sesuai identitas aplikasi Anda agar sesuai kebijakan Nominatim.
GEOCODE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=KarcisApp/2.0 (demo pendaftaran kegiatan)

# Notifikasi email. Kosongkan SMTP_HOST untuk mode dev (email hanya dicatat ke log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Kirim pengingat H-1 untuk kegiatan yang mulai dalam sekian jam
REMINDER_HOURS=24
